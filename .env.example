# PondFish Ecosystem Environment Variables Configuration Template
# COPY THIS FILE TO .env AND POPULATE SECRETS PRIOR TO RUNNING THE APPLICATION

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL 15)
DATABASE_URL=postgresql://pondfish_user:pondfish_password@localhost:5432/pondfish_db?schema=public

# Redis Configuration (Redis 7)
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=<GENERATED_SECRET>

# External Service Integrations (Placeholders)
RAZORPAY_KEY_ID=<SECRET_STORE>
RAZORPAY_KEY_SECRET=<SECRET_STORE>
ONELAP_API_KEY=<SECRET_STORE>
FCM_SERVER_KEY=<SECRET_STORE>

# Feature Flags & Adapters (development | production)
OCR_ADAPTER=mock
SMS_ADAPTER=mock
NOTIFICATION_ADAPTER=mock
